{
  "name": "dsh-bottom-info-bar",
  "version": "1.2.0",
  "description": "DeepSeek Harness 底部信息栏插件：替换原生统计栏，按当前路由显示多平台余额或 ChatGPT/OpenCode Go 订阅额度。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-bottom-info-bar",
    "balance",
    "usage",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/772758976youxiang-lgtm/Sterling-Harness-win--.git"
  },
  "homepage": "https://github.com/772758976youxiang-lgtm/Sterling-Harness-win--",
  "bugs": {
    "url": "https://github.com/772758976youxiang-lgtm/Sterling-Harness-win--/issues"
  },
  "author": "songoao25",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node ../tests/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
