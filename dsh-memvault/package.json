{
  "name": "dsh-memvault",
  "version": "1.0.0",
  "description": "记忆系统（memvault）Host 半体：注册 4 个模型工具（memory_list / memory_view / memory_save / session_search）并暴露 /api/memvault/* HTTP JSON API，数据持久化到 <workspaceRoot>/.dsh-memory/",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "memory",
    "memvault",
    "plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}
